<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <ApplicationId>app.steamdl</ApplicationId>
    <ApplicationTitle>SteamDl</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- 自用侧载包:仅构建 arm64,产物更小 -->
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <!-- PoC 开关:由 .NET-for-Android 宿主打包 Flutter add-to-app AAR,默认关闭以保持现有构建稳定。 -->
    <EnableFlutterPoc Condition="'$(EnableFlutterPoc)' == ''">false</EnableFlutterPoc>
    <DefineConstants Condition="'$(EnableFlutterPoc)' == 'true'">$(DefineConstants);ENABLE_FLUTTER_POC</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SteamDl.Core\SteamDl.Core.csproj" />
  </ItemGroup>

  <!-- Flutter add-to-app PoC:build.mjs build-flutter-poc 会把 Flutter AAR/JAR 收集到 FlutterPoc/libs。 -->
  <ItemGroup Condition="'$(EnableFlutterPoc)' == 'true'">
    <AndroidLibrary Include="FlutterPoc\libs\*.aar" Bind="false" Pack="true" />
    <AndroidLibrary Include="FlutterPoc\libs\*.jar" Bind="false" Pack="true" />
  </ItemGroup>

  <!-- protobuf-net/SteamKit2 依赖反射,禁止裁剪器移除其成员,否则 Release 包登录/存档会失败 -->
  <ItemGroup>
    <TrimmerRootAssembly Include="SteamDl.Core" RootMode="All" />
    <TrimmerRootAssembly Include="SteamKit2" RootMode="All" />
    <TrimmerRootAssembly Include="protobuf-net" RootMode="All" />
    <TrimmerRootAssembly Include="protobuf-net.Core" RootMode="All" />
  </ItemGroup>
</Project>
